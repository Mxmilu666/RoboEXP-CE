<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:RoboExp.App.Properties"
             x:Class="RoboExp.App.Properties.PropertiesPanelView"
             x:DataType="p:PropertiesPanelViewModel"
             Background="{DynamicResource StudioPanelBrush}" Foreground="{DynamicResource StudioTextBrush}">
    <Panel>
        <ContentControl Content="{Binding Editor}" />
    </Panel>
</UserControl>
