<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:RoboExp.App.Localization"
        xmlns:s="using:RoboExp.App.Setup"
        x:Class="RoboExp.App.Setup.SetupWizardWindow"
        x:DataType="s:SetupWizardViewModel"
        Title="{l:Tr Port:Setup.Title, Plain=True}"
        Width="720" Height="480" MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Window.Styles>
        <Style Selector="TextBlock.step">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Foreground" Value="#808080" />
        </Style>
        <Style Selector="TextBlock.step.current">
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style Selector="TextBlock.status">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="#404040" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
    </Window.Styles>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0" Padding="12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BackButton" Content="{l:Tr Port:Setup.Back}" Command="{Binding BackCommand}" MinWidth="90" />
                    <Button x:Name="NextButton" Content="{l:Tr Port:Setup.Next}" Command="{Binding NextCommand}" IsVisible="{Binding !IsFinish}" IsDefault="True" MinWidth="90" />
                    <Button x:Name="FinishButton" Content="{l:Tr Port:Setup.Finish}" Command="{Binding FinishCommand}" IsVisible="{Binding IsFinish}" IsDefault="True" MinWidth="90" />
                    <Button Content="{l:Tr Port:Setup.Close}" Click="OnCloseClick" IsEnabled="{Binding IsIdle}" MinWidth="90" />
                </StackPanel>
                <StackPanel Spacing="4" IsVisible="{Binding IsBusy}" Margin="0,0,16,0" VerticalAlignment="Center">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="{l:Tr Port:Setup.Cancel}" Command="{Binding CancelOperationCommand}" />
                        <ProgressBar Value="{Binding Progress}" IsIndeterminate="{Binding ProgressIndeterminate}" Minimum="0" Maximum="100" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding ProgressLabel}" FontSize="11" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Left" Width="170" Background="#F2F4F7" Padding="16,20">
            <StackPanel>
                <TextBlock Text="RoboExp CE" FontSize="16" FontWeight="Bold" Foreground="#1F5FA8" Margin="0,0,0,20" />
                <TextBlock Classes="step" Classes.current="{Binding IsWelcome}" Text="{l:Tr Port:Setup.StepWelcome, Plain=True}" />
                <TextBlock Classes="step" Classes.current="{Binding IsVendor}" Text="{l:Tr Port:Setup.StepVendor, Plain=True}" />
                <TextBlock Classes="step" Classes.current="{Binding IsToolchain}" Text="{l:Tr Port:Setup.StepToolchain, Plain=True}" />
                <TextBlock Classes="step" Classes.current="{Binding IsFinish}" Text="{l:Tr Port:Setup.StepFinish, Plain=True}" />
            </StackPanel>
        </Border>
        <Panel Margin="24,20">
            <StackPanel IsVisible="{Binding IsWelcome}">
                <TextBlock Classes="heading" Text="{l:Tr Port:Setup.WelcomeHeading, Plain=True}" />
                <TextBlock Text="{l:Tr Port:Setup.WelcomeText, Plain=True}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,20,0,0">
                    <TextBlock Text="{l:Tr Port:Setup.LanguageLabel, Plain=True}" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding Languages}" SelectedIndex="{Binding LanguageIndex}" MinWidth="160" />
                </StackPanel>
            </StackPanel>
            <StackPanel IsVisible="{Binding IsVendor}">
                <TextBlock Classes="heading" Text="{l:Tr Port:Setup.VendorHeading, Plain=True}" />
                <TextBlock Text="{l:Tr Port:Setup.VendorText, Plain=True}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
                    <Button Content="{l:Tr Port:Setup.ImportInstaller}" Command="{Binding ImportInstallerCommand}" />
                    <Button Content="{l:Tr Port:Setup.ChooseVendorFolder}" Command="{Binding ChooseVendorFolderCommand}" />
                </StackPanel>
                <DockPanel Margin="0,10,0,0">
                    <Button x:Name="UseVendorPathButton" DockPanel.Dock="Right" Margin="8,0,0,0" Content="{l:Tr Port:Setup.Use}" Command="{Binding UseVendorPathCommand}" />
                    <TextBox x:Name="VendorPathBox" Text="{Binding VendorPathInput}" PlaceholderText="{l:Tr Port:Setup.VendorPathHint, Plain=True}" IsEnabled="{Binding IsIdle}" />
                </DockPanel>
                <TextBlock Classes="status" Text="{Binding VendorStatusText}" />
            </StackPanel>
            <StackPanel IsVisible="{Binding IsToolchain}">
                <TextBlock Classes="heading" Text="{l:Tr Port:Setup.ToolchainHeading, Plain=True}" />
                <TextBlock Text="{l:Tr Port:Setup.ToolchainText, Plain=True}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
                    <Button x:Name="DownloadButton" Content="{Binding DownloadLabel}" Command="{Binding DownloadToolchainCommand}" IsVisible="{Binding HasPackage}" />
                    <Button Content="{l:Tr Port:Setup.ChooseToolchain}" Command="{Binding ChooseToolchainCommand}" />
                </StackPanel>
                <DockPanel Margin="0,10,0,0">
                    <Button x:Name="UseToolchainPathButton" DockPanel.Dock="Right" Margin="8,0,0,0" Content="{l:Tr Port:Setup.Use}" Command="{Binding UseToolchainPathCommand}" />
                    <TextBox x:Name="ToolchainPathBox" Text="{Binding ToolchainPathInput}" PlaceholderText="{l:Tr Port:Setup.ToolchainPathHint, Plain=True}" IsEnabled="{Binding IsIdle}" />
                </DockPanel>
                <TextBlock Classes="status" Text="{l:Tr Port:Setup.NoPackage, Plain=True}" IsVisible="{Binding !HasPackage}" />
                <TextBlock Classes="status" Text="{Binding ToolchainStatusText}" />
            </StackPanel>
            <StackPanel IsVisible="{Binding IsFinish}">
                <TextBlock Classes="heading" Text="{l:Tr Port:Setup.FinishHeading, Plain=True}" />
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
            </StackPanel>
        </Panel>
    </DockPanel>
</Window>
